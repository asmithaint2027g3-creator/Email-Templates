# Local Gmail SMTP credentials for sending single test emails
# Generate an App Password in your Google Account (Security -> 2-Step Verification -> App passwords)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# Default test recipient for test email dispatches
TEST_TO=your-email@gmail.com

# Base URL where static images will be hosted after Netlify deployment
# (e.g. https://trustgrid-email-templates.netlify.app)
EMAIL_ASSET_BASE_URL=https://your-deployed-site.netlify.app
